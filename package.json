{
  "name": "smart-commit-generator-ai",
  "displayName": "Smart Commit Generator AI",
  "description": "AI Git commit message generator, 1-click push, PR generator & safe branch sync. Supports Built-in IDE AI (Copilot), Free Gemini, Groq, Claude, OpenAI, OpenRouter, DeepSeek, Grok, Ollama & custom endpoints.",
  "version": "1.5.2",
  "publisher": "Hessam-Mamagani",
  "author": {
    "name": "Hessam Barasm Mamagani",
    "email": "hessam.mamagani@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hessam-Mamagani/smart-commit-generator.git"
  },
  "bugs": {
    "url": "https://github.com/Hessam-Mamagani/smart-commit-generator/issues"
  },
  "homepage": "https://github.com/Hessam-Mamagani/smart-commit-generator#readme",
  "keywords": [
    "git",
    "commit",
    "ai",
    "ai commit",
    "commit message generator",
    "conventional commits",
    "claude",
    "anthropic",
    "openrouter",
    "deepseek",
    "gemini",
    "groq",
    "grok",
    "ollama",
    "openai",
    "chatgpt",
    "free ai",
    "pull-request",
    "git push",
    "branch sync",
    "merge conflicts",
    "copilot",
    "cursor",
    "scm",
    "productivity",
    "developer tools"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onView:workbench.scm",
    "onView:smartCommit.actionsView",
    "onView:smartCommit.actionsViewScm"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartCommitActivityBar",
          "title": "Smart Commit Generator AI",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "smartCommitActivityBar": [
        {
          "id": "smartCommit.actionsView",
          "name": "Smart Commit Generator AI",
          "type": "webview"
        },
        {
          "id": "smartCommit.badgeView",
          "name": "Smart Commit Changes Counter",
          "when": "false"
        }
      ],
      "scm": [
        {
          "id": "smartCommit.actionsViewScm",
          "name": "Smart Commit Generator AI",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "smartCommit.selectProvider",
        "title": "Smart Git: Select Active AI Provider",
        "icon": "$(gear)"
      },
      {
        "command": "smartCommit.manageApiKeys",
        "title": "Smart Git: Manage API Keys (Secure Storage)",
        "icon": "$(key)"
      },
      {
        "command": "smartCommit.selectRepository",
        "title": "Smart Git: Select Active Repository",
        "icon": "$(repo)"
      },
      {
        "command": "smartCommit.generate",
        "title": "Smart Commit: Generate Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "smartCommit.generateCommitAndPush",
        "title": "Smart Commit: Generate, Commit & Push",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "smartCommit.generatePR",
        "title": "Smart Commit: Generate PR Description",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "smartCommit.compareBranches",
        "title": "Smart Commit: Compare Branches & Conflict Advisor",
        "icon": "$(diff)"
      },
      {
        "command": "smartCommit.syncToBranch",
        "title": "Smart Commit: Safe Sync & Push to Branch",
        "icon": "$(git-merge)"
      },
      {
        "command": "smartCommit.enableFastMode",
        "title": "Smart Git: Safe Mode Active (Click to switch to Fast Mode)",
        "icon": "$(shield)"
      },
      {
        "command": "smartCommit.disableFastMode",
        "title": "Smart Git: Fast Mode Active (Click to switch to Safe Mode)",
        "icon": "$(zap)"
      },
      {
        "command": "smartCommit.toggleFastPush",
        "title": "Smart Commit: Toggle Fast Push / Safe Mode",
        "icon": "$(zap)"
      },
      {
        "command": "smartCommit.quickMenu",
        "title": "Smart Commit: Quick Menu",
        "icon": "$(sparkle)"
      },
      {
        "command": "smartCommit.switchBranch",
        "title": "Smart Git: Switch / Checkout Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "smartCommit.undoCommit",
        "title": "Smart Git: Undo Last Commit (Soft Reset)",
        "icon": "$(discard)"
      },
      {
        "command": "smartCommit.pushCommits",
        "title": "Smart Git: Push Commits to Remote",
        "icon": "$(cloud-upload)"
      }
    ],
    "keybindings": [
      {
        "command": "smartCommit.generate",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "smartCommit.generateCommitAndPush",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "smartCommit.syncToBranch",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "smartCommit.compareBranches",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "smartCommit.toggleFastPush",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "smartCommit.generate",
          "group": "navigation@1"
        },
        {
          "command": "smartCommit.generateCommitAndPush",
          "group": "navigation@2"
        },
        {
          "command": "smartCommit.syncToBranch",
          "group": "navigation@3"
        },
        {
          "command": "smartCommit.generatePR",
          "group": "navigation@4"
        },
        {
          "command": "smartCommit.compareBranches",
          "group": "navigation@5"
        },
        {
          "command": "smartCommit.enableFastMode",
          "when": "!smartCommit:isFastMode",
          "group": "navigation@6"
        },
        {
          "command": "smartCommit.disableFastMode",
          "when": "smartCommit:isFastMode",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "smartCommit.generate",
          "when": "view == workbench.scm",
          "group": "navigation@1"
        },
        {
          "command": "smartCommit.generateCommitAndPush",
          "when": "view == workbench.scm",
          "group": "navigation@2"
        },
        {
          "command": "smartCommit.syncToBranch",
          "when": "view == workbench.scm",
          "group": "navigation@3"
        },
        {
          "command": "smartCommit.generatePR",
          "when": "view == workbench.scm",
          "group": "navigation@4"
        },
        {
          "command": "smartCommit.compareBranches",
          "when": "view == workbench.scm",
          "group": "navigation@5"
        },
        {
          "command": "smartCommit.enableFastMode",
          "when": "view == workbench.scm && !smartCommit:isFastMode",
          "group": "navigation@6"
        },
        {
          "command": "smartCommit.disableFastMode",
          "when": "view == workbench.scm && smartCommit:isFastMode",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "smartCommit.enableFastMode",
          "when": "false"
        },
        {
          "command": "smartCommit.disableFastMode",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Smart Commit Generator",
      "properties": {
        "smartCommit.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "vscode-lm",
            "groq",
            "ollama",
            "claude",
            "openai",
            "openrouter",
            "deepseek",
            "grok",
            "custom"
          ],
          "enumDescriptions": [
            "Google Gemini (Free tier via Google AI Studio, default: gemini-3.8-flash)",
            "Built-in IDE AI / GitHub Copilot (Zero API key required, VS Code 1.90+)",
            "Groq (Free tier, ultra-fast LPU inference)",
            "Local Ollama (100% free & offline, zero API key)",
            "Anthropic Claude (default: claude-haiku-5-5)",
            "OpenAI (default: gpt-4o-mini)",
            "OpenRouter (200+ models via one key, default: openai/gpt-4o-mini)",
            "DeepSeek (default: deepseek-chat)",
            "xAI Grok (default: grok-4.20-0309-non-reasoning)",
            "Custom OpenAI-Compatible Endpoint (LM Studio, Azure, vLLM, LiteLLM)"
          ],
          "default": "gemini",
          "description": "Active AI provider for commit messages, PR descriptions, and branch analysis."
        },
        "smartCommit.model": {
          "type": "string",
          "default": "",
          "description": "Optional model override (leave blank to use provider defaults: gemini-3.8-flash, llama-3.3-70b-versatile, llama3.2, claude-haiku-5-5, gpt-4o-mini, openai/gpt-4o-mini, deepseek-chat, or grok-4.20-0309-non-reasoning)."
        },
        "smartCommit.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local Ollama server endpoint (default: http://localhost:11434)."
        },
        "smartCommit.customBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for Custom OpenAI-compatible provider (e.g., http://localhost:1234/v1 or full chat completions endpoint)."
        },
        "smartCommit.commitLanguage": {
          "type": "string",
          "default": "English",
          "description": "Language for generated commit descriptions and PR summaries (Conventional Commit prefixes like feat/fix remain in English)."
        },
        "smartCommit.useGitmoji": {
          "type": "boolean",
          "default": false,
          "description": "Prefix generated commit headers with an appropriate Gitmoji matching the commit type."
        },
        "smartCommit.customPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional extra instructions appended to the commit generation system prompt (e.g., team naming conventions or style rules)."
        },
        "smartCommit.excludeFromDiff": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "bun.lockb",
            "bun.lock",
            "Cargo.lock",
            "composer.lock",
            "Gemfile.lock",
            "poetry.lock",
            "Pipfile.lock",
            "go.sum",
            "*.min.js",
            "*.min.css",
            "*.map",
            "*.snap",
            "dist/**",
            "build/**",
            ".next/**"
          ],
          "description": "Glob patterns excluded from raw diffs sent to AI so lockfiles and build artifacts never truncate real code changes."
        },
        "smartCommit.autoStage": {
          "type": "boolean",
          "default": false,
          "description": "Automatically stage all modified files if nothing is staged before generating."
        },
        "smartCommit.confirmBeforePush": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before automatically pushing to the remote repository."
        },
        "smartCommit.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch for PR description generation (e.g., main or master). Auto-detected if left empty."
        },
        "smartCommit.autoBumpVersion": {
          "type": "boolean",
          "default": true,
          "description": "Automatically calculate and bump semver in package.json when syncing to release/publish branches."
        },
        "smartCommit.openaiApiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use 'Smart Git: Manage API Keys (Secure Storage)' instead.",
          "description": "Legacy OpenAI API Key setting (automatically synced to Secret Storage)."
        },
        "smartCommit.geminiApiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use 'Smart Git: Manage API Keys (Secure Storage)' instead.",
          "description": "Legacy Google Gemini API Key setting (automatically synced to Secret Storage)."
        },
        "smartCommit.deepseekApiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use 'Smart Git: Manage API Keys (Secure Storage)' instead.",
          "description": "Legacy DeepSeek API Key setting (automatically synced to Secret Storage)."
        },
        "smartCommit.groqApiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use 'Smart Git: Manage API Keys (Secure Storage)' instead.",
          "description": "Legacy Groq API Key setting (automatically synced to Secret Storage)."
        },
        "smartCommit.grokApiKey": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use 'Smart Git: Manage API Keys (Secure Storage)' instead.",
          "description": "Legacy xAI Grok API Key setting (automatically synced to Secret Storage)."
        }
      }
    }
  }
}
