{
  "name": "smart-commit-generator-ai",
  "displayName": "Smart Commit Generator AI",
  "description": "AI Git commit message generator, 1-click push, PR generator & safe branch sync. Supports OpenAI, Free Gemini, DeepSeek, Groq, Grok & local Ollama.",
  "version": "1.4.1",
  "publisher": "Hessam-Mamagani",
  "author": {
    "name": "Hessam Barasm Mamagani",
    "email": "hessam.mamagani@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hessam-Mamagani/smart-commit-generator.git"
  },
  "bugs": {
    "url": "https://github.com/Hessam-Mamagani/smart-commit-generator/issues"
  },
  "homepage": "https://github.com/Hessam-Mamagani/smart-commit-generator#readme",
  "keywords": [
    "git",
    "commit",
    "ai",
    "ai commit",
    "commit message generator",
    "conventional commits",
    "deepseek",
    "gemini",
    "groq",
    "grok",
    "ollama",
    "openai",
    "chatgpt",
    "free ai",
    "pull-request",
    "git push",
    "branch sync",
    "merge conflicts",
    "copilot alternative",
    "cursor",
    "scm",
    "productivity",
    "developer tools"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:workbench.scm",
    "onView:smartCommit.actionsView",
    "onView:smartCommit.actionsViewScm"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartCommitActivityBar",
          "title": "Smart Commit Generator AI",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "smartCommitActivityBar": [
        {
          "id": "smartCommit.actionsView",
          "name": "Smart Commit Generator AI",
          "type": "webview"
        }
      ],
      "scm": [
        {
          "id": "smartCommit.actionsViewScm",
          "name": "Smart Commit Generator AI",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "smartCommit.selectProvider",
        "title": "Smart Git: Select Active AI Provider",
        "icon": "$(gear)"
      },
      {
        "command": "smartCommit.selectRepository",
        "title": "Smart Git: Select Active Repository",
        "icon": "$(repo)"
      },
      {
        "command": "smartCommit.generate",
        "title": "Smart Commit: Generate Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "smartCommit.generateCommitAndPush",
        "title": "Smart Commit: Generate, Commit & Push",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "smartCommit.generatePR",
        "title": "Smart Commit: Generate PR Description",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "smartCommit.compareBranches",
        "title": "Smart Commit: Compare Branches & Conflict Advisor",
        "icon": "$(diff)"
      },
      {
        "command": "smartCommit.syncToBranch",
        "title": "Smart Commit: Safe Sync & Push to Branch",
        "icon": "$(git-merge)"
      },
      {
        "command": "smartCommit.enableFastMode",
        "title": "Smart Git: Safe Mode Active (Click to switch to Fast Mode)",
        "icon": "$(shield)"
      },
      {
        "command": "smartCommit.disableFastMode",
        "title": "Smart Git: Fast Mode Active (Click to switch to Safe Mode)",
        "icon": "$(zap)"
      },
      {
        "command": "smartCommit.toggleFastPush",
        "title": "Smart Commit: Toggle Fast Push / Safe Mode",
        "icon": "$(zap)"
      },
      {
        "command": "smartCommit.quickMenu",
        "title": "Smart Commit: Quick Menu",
        "icon": "$(sparkle)"
      },
      {
        "command": "smartCommit.switchBranch",
        "title": "Smart Git: Switch / Checkout Branch",
        "icon": "$(git-branch)"
      }
    ],
    "keybindings": [
      {
        "command": "smartCommit.generate",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "smartCommit.generateCommitAndPush",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "smartCommit.syncToBranch",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "smartCommit.compareBranches",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "smartCommit.toggleFastPush",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "smartCommit.generate",
          "group": "navigation@1"
        },
        {
          "command": "smartCommit.generateCommitAndPush",
          "group": "navigation@2"
        },
        {
          "command": "smartCommit.syncToBranch",
          "group": "navigation@3"
        },
        {
          "command": "smartCommit.generatePR",
          "group": "navigation@4"
        },
        {
          "command": "smartCommit.compareBranches",
          "group": "navigation@5"
        },
        {
          "command": "smartCommit.enableFastMode",
          "when": "!smartCommit:isFastMode",
          "group": "navigation@6"
        },
        {
          "command": "smartCommit.disableFastMode",
          "when": "smartCommit:isFastMode",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "smartCommit.generate",
          "when": "view == workbench.scm",
          "group": "navigation@1"
        },
        {
          "command": "smartCommit.generateCommitAndPush",
          "when": "view == workbench.scm",
          "group": "navigation@2"
        },
        {
          "command": "smartCommit.syncToBranch",
          "when": "view == workbench.scm",
          "group": "navigation@3"
        },
        {
          "command": "smartCommit.generatePR",
          "when": "view == workbench.scm",
          "group": "navigation@4"
        },
        {
          "command": "smartCommit.compareBranches",
          "when": "view == workbench.scm",
          "group": "navigation@5"
        },
        {
          "command": "smartCommit.enableFastMode",
          "when": "view == workbench.scm && !smartCommit:isFastMode",
          "group": "navigation@6"
        },
        {
          "command": "smartCommit.disableFastMode",
          "when": "view == workbench.scm && smartCommit:isFastMode",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "smartCommit.enableFastMode",
          "when": "false"
        },
        {
          "command": "smartCommit.disableFastMode",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Smart Commit Generator",
      "properties": {
        "smartCommit.provider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "deepseek",
            "groq",
            "grok",
            "ollama"
          ],
          "default": "openai",
          "description": "Provider to use: 'openai', 'gemini' (Free tier), 'deepseek', 'groq' (Free tier), 'grok' (xAI), or 'ollama' (local offline)."
        },
        "smartCommit.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key."
        },
        "smartCommit.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API Key (100% free at Google AI Studio)."
        },
        "smartCommit.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key (from platform.deepseek.com)."
        },
        "smartCommit.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Groq API Key (free from console.groq.com)."
        },
        "smartCommit.grokApiKey": {
          "type": "string",
          "default": "",
          "description": "xAI Grok API Key (from console.x.ai)."
        },
        "smartCommit.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local Ollama server endpoint (default: http://localhost:11434)."
        },
        "smartCommit.model": {
          "type": "string",
          "default": "",
          "description": "Model override (leave blank to use provider defaults: gpt-4o-mini, gemini-3.8-flash, deepseek-chat, llama-3.3-70b-versatile, or llama3.2)."
        },
        "smartCommit.autoStage": {
          "type": "boolean",
          "default": false,
          "description": "Automatically stage all modified files if nothing is staged before generating."
        },
        "smartCommit.confirmBeforePush": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before automatically pushing to the remote repository."
        },
        "smartCommit.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch for PR description generation (e.g., main or master). Auto-detected if left empty."
        },
        "smartCommit.autoBumpVersion": {
          "type": "boolean",
          "default": true,
          "description": "Automatically calculate and bump semver in package.json when syncing to release/publish branches."
        }
      }
    }
  }
}
